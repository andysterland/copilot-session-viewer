{
  "name": "@qiaolei81/copilot-session-viewer",
  "version": "0.4.3",
  "description": "Web UI for viewing GitHub Copilot CLI session logs",
  "author": "Lei Qiao <qiaolei81@gmail.com>",
  "license": "MIT",
  "main": "dist/server.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andysterland/copilot-session-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/andysterland/copilot-session-viewer/issues"
  },
  "homepage": "https://github.com/andysterland/copilot-session-viewer#readme",
  "keywords": [
    "copilot",
    "github-copilot",
    "session-viewer",
    "log-viewer",
    "cli",
    "ai",
    "developer-tools",
    "vue",
    "express"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "copilot-session-viewer": "./bin/copilot-session-viewer"
  },
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cross-env E2E_USE_FIXTURES=1 playwright test",
    "test:e2e:headed": "cross-env E2E_USE_FIXTURES=1 playwright test --headed",
    "test:e2e:debug": "cross-env E2E_USE_FIXTURES=1 playwright test --debug",
    "test:all": "npm test && npm run test:e2e",
    "test:coverage:all": "npm run test:coverage && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "build:prod": "node scripts/build.mjs --prod",
    "dev:client": "vite",
    "build:client": "vite build",
    "generate:api": "openapi-typescript openapi.yaml -o src/client/api/schema.d.ts",
    "prepublishOnly": "npm run build:prod",
    "electron:dev": "npm run build && cross-env E2E_USE_FIXTURES=1 electron electron/main.js",
    "electron:licenses": "node electron/scripts/generate-licenses.js",
    "electron:sbom": "cyclonedx-npm --omit dev --output-file electron/generated/sbom.cdx.json",
    "electron:prepare": "npm run build && npm run electron:licenses && npm run electron:sbom",
    "electron:unpacked": "npm run electron:prepare && electron-builder --dir",
    "electron:dist": "npm run electron:prepare && electron-builder --publish never",
    "electron:dist:win": "npm run electron:prepare && electron-builder --win nsis --publish never",
    "electron:dist:msi": "npm run electron:prepare && electron-builder --win msi --config.msi.warningsAsErrors=false --publish never",
    "electron:dist:mac": "npm run electron:prepare && electron-builder --mac dmg zip -c.mac.notarize=false --publish never",
    "electron:dist:mac:release": "npm run electron:prepare && electron-builder --mac dmg zip --publish never",
    "electron:dist:linux": "npm run electron:prepare && electron-builder --linux AppImage --publish never",
    "electron:checksums": "node electron/scripts/generate-checksums.js",
    "electron:smoke": "node electron/scripts/smoke.js",
    "test:electron": "jest --config __tests__/electron/jest.config.js --runInBand",
    "test:electron:e2e": "npm run build && cross-env E2E_USE_FIXTURES=1 playwright test --config __tests__/electron/playwright.config.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "compression": "^1.8.1",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "js-yaml": "^5.2.3",
    "marked": "^18.0.4",
    "multer": "^2.2.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@electron/fuses": "^2.1.3",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "c8": "^11.0.0",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jsdom": "^28.1.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "nodemon": "^3.0.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "desktop": {
    "appId": "com.github.andysterland.copilot-session-viewer",
    "productName": "Copilot Session Viewer",
    "repositoryOwner": "andysterland",
    "repositoryName": "copilot-session-viewer"
  }
}
